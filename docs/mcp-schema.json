            "technical_depth": 4,
            "customer_evidence": 5,
            "velocity": 4,
            "sp_leverage": 4,
            "round_fit": 4
          },
          "next_step": {
            "type": "submit",
            "prescreen_ref": "pf_…"
          }
        }
      }
    },
    {
      "name": "lp_fit",
      "title": "LP mutual-fit read",
      "status": "partial",
      "tier": 0,
      "requires_token": false,
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      },
      "description": "Given an LP's mandate, an honest read on whether shuckerVC fits their box — including when we do not. Returns only tier-0 content, and names what exists at higher tiers without describing it.",
      "blocked_by": [
        "Counsel has not reviewed the tier-0/tier-1 split in config/lp-icp.json. Fund I is closed and Fund II is undefined, so nothing is being offered — but the Fund I track record is a performance claim and sits behind request_access for that reason.",
        "The ticket_exceeds_vehicle blocker is unparameterised until Fund II is sized. It currently uses a provisional bound."
      ],
